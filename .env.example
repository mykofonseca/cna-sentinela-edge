# Copie para .env (na raiz do repositório) e preencha. O .env não é versionado.

# HiveMQ Cloud (usado pelo drone e pela ponte)
HIVEMQ_HOST=SEU-CLUSTER.s1.eu.hivemq.cloud
HIVEMQ_PORTA=8883
HIVEMQ_USUARIO=SEU_USUARIO
HIVEMQ_SENHA=SUA_SENHA
# 1 = TLS (padrão). 0 só para testar com um broker local sem TLS.
MQTT_TLS=1

# Ubidots (só a ponte usa). Sem token a ponte apenas mostra no terminal o que enviaria.
UBIDOTS_TOKEN=SEU_TOKEN_UBIDOTS
UBIDOTS_HOST=industrial.api.ubidots.com
# Intervalo mínimo (s) entre temperaturas enviadas ao Ubidots, por zona.
UBIDOTS_INTERVALO_TEMP=10

# Drone: segundos entre as etapas do voo simulado
DRONE_TEMPO_ETAPA=4
