{
  "version": 1,
  "author": "Maykon Santana Fonseca, Gustavo Franzoti Gonçalves",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": -140,
      "left": -170,
      "attrs": { "delayTime": "8" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "portao",
      "top": 60,
      "left": -190,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "tamper",
      "top": 150,
      "left": -210,
      "attrs": { "color": "red", "label": "TAMPER" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -150,
      "left": 230,
      "attrs": { "temperature": "26.0", "humidity": "45" }
    },
    {
      "type": "wokwi-rgb-led",
      "id": "led",
      "top": 30,
      "left": 250,
      "attrs": { "common": "cathode" }
    },
    { "type": "wokwi-resistor", "id": "rR", "top": 140, "left": 200, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rG", "top": 140, "left": 230, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rB", "top": 140, "left": 260, "rotate": 90, "attrs": { "value": "220" } },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 220,
      "left": 230,
      "attrs": { "volume": "0.2" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": 300,
      "left": -60,
      "attrs": { "pins": "i2c" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "pir:VCC", "esp:5V", "red", [] ],
    [ "pir:GND", "esp:GND.1", "black", [] ],
    [ "pir:OUT", "esp:27", "orange", [] ],

    [ "portao:2", "esp:26", "violet", [] ],
    [ "portao:1", "esp:GND.1", "black", [] ],

    [ "tamper:1.r", "esp:25", "red", [] ],
    [ "tamper:2.r", "esp:GND.1", "black", [] ],

    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.2", "black", [] ],
    [ "dht:SDA", "esp:33", "green", [] ],

    [ "led:R", "rR:1", "red", [] ],
    [ "led:G", "rG:1", "green", [] ],
    [ "led:B", "rB:1", "blue", [] ],
    [ "led:COM", "esp:GND.2", "black", [] ],
    [ "rR:2", "esp:16", "red", [] ],
    [ "rG:2", "esp:17", "green", [] ],
    [ "rB:2", "esp:4", "blue", [] ],

    [ "buzzer:1", "esp:GND.3", "black", [] ],
    [ "buzzer:2", "esp:13", "gold", [] ],

    [ "lcd:GND", "esp:GND.3", "black", [] ],
    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:SDA", "esp:21", "blue", [] ],
    [ "lcd:SCL", "esp:22", "purple", [] ]
  ],
  "dependencies": {}
}
